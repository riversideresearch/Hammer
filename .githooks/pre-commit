#!/bin/sh
# Hammer pre-commit hook
# Enforces formatting, whitespace rules, conflict markers, and Python/SCons linting.

set -e

echo "Running Hammer pre-commit checks..."

############################################
# 1. clang-format on staged C/C++ changes
############################################

FILES=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -E '\.(c|h|cpp|hpp)$' || true)

if [ -n "$FILES" ]; then
    echo "Formatting staged C/C++ changes with clang-format..."

    git clang-format --staged --extensions c,h,cpp,hpp
fi

############################################
# 2. Whitespace / diff cleanliness
############################################

echo "Checking whitespace errors (git diff --check)..."
git diff --cached --check
if [ $? -ne 0 ]; then
    echo "ERROR: Whitespace issues and/or Merge conflict markers detected. Fix them before committing."
    exit 1
fi

############################################
# 3. Ruff linting (Python + SCons)
############################################

echo "Running Ruff linting on staged files..."

RUFF_FAILED=0

git diff --cached --name-only --diff-filter=ACM -z |
while IFS= read -r -d '' f; do
    case "$f" in
        *.py|*/SConstruct|*/SConscript|SConstruct|SConscript)
            echo "  Ruff: $f"

            git show ":$f" | ruff check --stdin-filename "$f" - || RUFF_FAILED=1
            ;;
    esac
done

############################################
# 4. Success
############################################

echo "All pre-commit checks passed."
exit 0
