#!/bin/sh
# Hammer pre-commit hook
# Enforces formatting, whitespace rules, conflict markers, and Python/SCons linting.

set -e

echo "Running Hammer pre-commit checks..."

############################################
# 1. clang-format on staged C/C++ files
############################################

FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(c|h|cpp|hpp)$' || true)

if [ -n "$FILES" ]; then
    echo "Formatting staged C/C++ files with clang-format..."
    for f in $FILES; do
        if [ -f "$f" ]; then
            clang-format -i "$f"
            git add "$f"
        fi
    done
fi

############################################
# 2. Whitespace / diff cleanliness
############################################

echo "Checking whitespace errors (git diff --check)..."
git diff --cached --check
if [ $? -ne 0 ]; then
    echo "ERROR: Whitespace issues detected. Fix them before committing."
    exit 1
fi

############################################
# 3. Merge conflict marker detection
############################################

echo "Checking for merge conflict markers..."
if git diff --cached | grep -E '<<<<<<<|=======|>>>>>>>'; then
    echo "ERROR: Merge conflict markers detected. Resolve conflicts before committing."
    exit 1
fi

############################################
# 4. Ruff linting (Python + SCons)
############################################

echo "Running ruff linting..."
PYFILES=$(find . -path ./build -prune -o \( -name "*.py" -o -name "SConstruct" -o -name "SConscript" \) -print)

if [ -n "$PYFILES" ]; then
    ruff check $PYFILES
fi

############################################
# 5. Success
############################################

echo "All pre-commit checks passed."
exit 0
